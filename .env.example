# ============================================================
#  SiteGuard 环境变量模板
#  用法：把本文件复制一份改名为 .env，然后填入真实值
#  .env 已被 .gitignore 忽略，不会进 Git —— 千万不要删掉那条规则
# ============================================================

# ---------- 华为云 MaaS（ModelArts Studio）大模型服务 ----------
# 【怎么拿】华为云控制台 → ModelArts Studio → 区域选「西南-贵阳一」
#          → 模型推理 → 在线推理 → 免费服务 → 领取额度 → 调用说明
#          → 复制 API 地址（把末尾的 /chat/completions 删掉，只留到 /v1）
MAAS_BASE_URL=https://你的API地址/v1

# 【怎么拿】同一个页面的「API Key 管理」→ 创建 API Key
#          注意：密钥只在创建时显示一次，务必立刻保存到这里
MAAS_API_KEY=sk-把这里换成你的真实密钥

# 模型名称，填控制台「调用说明」里给出的模型 ID
MAAS_MODEL=DeepSeek-V3

# ---------- 大模型运行模式 ----------
# auto ：配了真实 Key 就调真实模型；没配则自动用内置模拟诊断（默认，推荐开发期用）
# on   ：强制内置模拟诊断，不发出任何网络请求（断网 / 录屏演示时用）
# off  ：强制真实模型，没配好直接报错（正式提交、录演示视频前建议锁成 off）
#
# 说明：模拟模式不会编造数据 —— 它读取真实巡检报告的问题清单，
#       按类别给出根因与可执行建议，输出结构与真实模型完全一致。
MAAS_MODE=auto

# ---------- 巡检参数 ----------
# 自动巡检间隔（分钟）
SCAN_INTERVAL_MINUTES=30
# 单个 HTTP 请求超时（秒）
REQUEST_TIMEOUT=10
# 每次最多探测多少个页面内链（防止把别人网站扫挂）
MAX_LINKS_PER_PAGE=50
#响应极慢线->报P1
RESP_VERY_SLOW_MS=5000
#响应偏慢线->报P2
RESP_SLOW_MS=2000
#SSL证书快到期预警线->报P1
SSL_WARN_DAYS=15
