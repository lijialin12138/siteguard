# ============================================================
#  SiteGuard 环境变量模板
#  用法：把本文件复制一份改名为 .env，然后填入真实值
#  .env 已被 .gitignore 忽略，不会进 Git —— 千万不要删掉那条规则
# ============================================================

# ---------- 华为云 MaaS（ModelArts Studio）大模型服务 ----------
# 【重要·2026-10 更新】老的「免费服务 / DeepSeek-V3 200万免费token」已下线。
#   现在必须在 MaaS 控制台「开通服务」（按量计费）后才能调用。
#   码道 CodeArts 的「每日1000万token」只在码道 IDE 内可用，拿不到本项目 API 里来。
# 【在哪配】华为云控制台搜「MaaS」→ 区域选「西南-贵阳一」
#          → 在线推理 → 预置服务 → 选一个 flash 模型点「开通服务」
#          → 「调用说明」选 OpenAI SDK，复制 API 地址（删掉末尾 /chat/completions，只留到 /v1）
#   中国大陆站 OpenAI 兼容地址固定为：
MAAS_BASE_URL=https://api.modelarts-maas.com/openai/v1

# 【怎么拿】MaaS 控制台左侧「API Key 管理」→ 创建 API Key
#          注意：密钥只在创建时显示一次，务必立刻保存到这里
#          ⚠️ 本文件会被提交进 Git，【绝不】在此填写真实 Key，只写占位符！
#             真实 Key 只放在本地 .env（已被 .gitignore 忽略）。
MAAS_API_KEY=把这里换成你的真实密钥

# 模型名称：填控制台里的「model 参数值」（不是你看到的中文名）。
# 便宜可用的 flash 模型示例：deepseek-v4-flash / deepseek-v4.1-flash / glm-5.3 / kimi-k2.6
MAAS_MODEL=deepseek-v4-flash

# ---------- 大模型运行模式 ----------
# auto ：配了真实 Key 就调真实模型；没配则自动用内置模拟诊断（默认，推荐开发期用）
# on   ：强制内置模拟诊断，不发出任何网络请求（断网 / 录屏演示时用）
# off  ：强制真实模型，没配好直接报错（正式提交、录演示视频前建议锁成 off）
#
# 说明：模拟模式不会编造数据 —— 它读取真实巡检报告的问题清单，
#       按类别给出根因与可执行建议，输出结构与真实模型完全一致。
MAAS_MODE=auto

# ---------- API 鉴权（部署上线前启用，平时留空） ----------
# 留空 = 本地开发放行（不校验，方便联调）；部署到公网前设一个随机串，
# 所有 /api/* 接口将强制要求请求头 Authorization: Bearer <此值>，否则返回 401，
# 防止站点被任意删除 / MaaS 额度被外人烧。
# 前端对接：在 fetch 请求头里加 Authorization: Bearer <此值> 即可（本地留空时不用加）。
API_TOKEN=

# ---------- 巡检参数 ----------
# 自动巡检间隔（分钟）
SCAN_INTERVAL_MINUTES=30
# 单个 HTTP 请求超时（秒）
REQUEST_TIMEOUT=10
# 每次最多探测多少个页面内链（防止把别人网站扫挂）
MAX_LINKS_PER_PAGE=50
#响应极慢线->报P1
RESP_VERY_SLOW_MS=5000
#响应偏慢线->报P2
RESP_SLOW_MS=2000
#SSL证书快到期预警线->报P1
SSL_WARN_DAYS=15
